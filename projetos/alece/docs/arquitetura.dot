digraph alece_arquitetura {
	bgcolor="#111e18" fontcolor="#e5f4e8" fontname="DejaVu Sans" nodesep=0.52 pad=0.35 rankdir=TB ranksep=0.68
	node [color="#416651" fillcolor="#1a3024" fontcolor="#e5f4e8" fontname="DejaVu Sans" fontsize=12 margin="0.20,0.14" penwidth=1.2 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#789985" fontcolor="#b5d3bf" fontname="DejaVu Sans" fontsize=10]
	subgraph cluster_front {
		color="#416651" fontcolor="#b5d3bf" label="PESSOA / NAVEGADOR" style=rounded
		UI [label="Django templates + HTMX + Alpine.js
Tailwind CSS 4 (proposta de UI)" color="#78dc9e"]
	}
	subgraph cluster_app {
		color="#63896c" fontcolor="#78dc9e" label="ALECE / MONÓLITO MODULAR PYTHON" style=rounded
		Views [label="Views + autenticação
Escopo do usuário e permissões"]
		Services [label="Services Django
Casos de uso atômicos + locking"]
		Rules [label="Domínio puro
Decimal + invariantes financeiros"]
	}
	subgraph cluster_infra {
		color="#416651" fontcolor="#b5d3bf" label="INFRAESTRUTURA DO PROPRIETÁRIO" style=rounded
		DB [label="PostgreSQL
Dados locais / volume persistente" color="#e7c887" shape=cylinder]
		Backups [label="Backup + restauração
Verificação SHA-256 (processo operacional)" color="#e7c887"]
		Docker [label="Docker Compose
ZimaOS prioritário / Linux compatível" color="#a2c5f3"]
	}
	UI -> Views
	Views -> Services
	Services -> Rules
	Services -> DB
	DB -> Backups [style=dashed]
	Docker -> DB [arrowhead=none style=dashed]
	Docker -> Views [arrowhead=none style=dashed]
}
